# Public Supabase configuration used by browser/session clients
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server Supabase configuration
# SUPABASE_URL may match NEXT_PUBLIC_SUPABASE_URL but remains explicit for server/admin code.
# Use a current sb_secret_... key for privileged server-only operations.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Canonical public application origin used for invitation redirects.
# This must be the trusted application origin, not a request-derived host.
# Example: https://saga.example.com
SAGA_PUBLIC_APP_URL=

# Backblaze B2 runtime storage (bucket-scoped non-master application key)
SAGA_B2_BUCKET=saga-v2-faresmohamed260-1207062480
SAGA_B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
SAGA_B2_REGION=us-east-005
SAGA_B2_APPLICATION_KEY_ID=
SAGA_B2_APPLICATION_KEY=

# Do NOT place the B2 master bootstrap credentials here.
# SAGA_B2_KEY_ID and SAGA_B2_MASTER_APPLICATION_KEY belong only in GitHub Actions secrets.
