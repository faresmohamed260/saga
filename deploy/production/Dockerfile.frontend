FROM node:22.18.0-alpine AS build
WORKDIR /app
COPY apps/dashboard_pro/package.json apps/dashboard_pro/package-lock.json ./
RUN npm ci
COPY apps/dashboard_pro/ ./
ARG VITE_RUNTIME_API_BASE=/api
ENV VITE_RUNTIME_API_BASE=${VITE_RUNTIME_API_BASE}
RUN npm run build

FROM nginx:1.29.1-alpine
COPY deploy/production/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
