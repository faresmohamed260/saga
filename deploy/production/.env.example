SAGA_RELEASE_ID=release-0.1.0-000000000000
SAGA_RUNTIME_IMAGE=ghcr.io/owner/saga-runtime@sha256:inject-at-deploy-time
SAGA_DASHBOARD_IMAGE=ghcr.io/owner/saga-dashboard@sha256:inject-at-deploy-time
SAGA_PERSISTENCE_NETWORK=supabase_default
SAGA_RUNTIME_DB_MODE=supabase_postgres
